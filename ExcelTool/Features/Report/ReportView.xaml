<UserControl x:Class="ExcelTool.Features.Report.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Báo cáo"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Tổng hợp tình hình khách hàng, báo giá và sản xuất"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="Xuất báo cáo"
                    Width="125"
                    Height="42"
                    Background="#1976D2"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Cursor="Hand"/>

        </Grid>


        <!-- FILTER -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Margin="25,0,25,15"
                Padding="15">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="Khoảng thời gian:"
                           VerticalAlignment="Center"
                           Foreground="#596579"
                           Margin="0,0,10,0"/>

                <DatePicker Width="150"
                            Height="38"
                            Margin="0,0,10,0"/>

                <TextBlock Text="đến"
                           VerticalAlignment="Center"
                           Foreground="#596579"
                           Margin="0,0,10,0"/>

                <DatePicker Width="150"
                            Height="38"
                            Margin="0,0,20,0"/>

                <Button Content="Xem báo cáo"
                        Width="110"
                        Height="38"
                        Background="#EEF5FD"
                        BorderBrush="#C7DCF5"
                        BorderThickness="1"
                        Foreground="#1976D2"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </StackPanel>

        </Border>


        <!-- CONTENT -->

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25,0,25,25">


                <!-- STATISTICS -->

                <WrapPanel>


                    <!-- KHÁCH HÀNG -->

                    <Border Width="220"
                            Height="125"
                            Background="White"
                            BorderBrush="#E1E6EF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,15,15"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Khách hàng"
                                       Foreground="#7A8499"
                                       FontSize="13"/>

                            <TextBlock Text="128"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#172033"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="+8 tháng này"
                                       Foreground="#2E7D32"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>


                    <!-- BÁO GIÁ -->

                    <Border Width="220"
                            Height="125"
                            Background="White"
                            BorderBrush="#E1E6EF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,15,15"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Báo giá"
                                       Foreground="#7A8499"
                                       FontSize="13"/>

                            <TextBlock Text="245"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#172033"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="+15 tháng này"
                                       Foreground="#2E7D32"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>


                    <!-- LỆNH SẢN XUẤT -->

                    <Border Width="220"
                            Height="125"
                            Background="White"
                            BorderBrush="#E1E6EF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,15,15"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Lệnh sản xuất"
                                       Foreground="#7A8499"
                                       FontSize="13"/>

                            <TextBlock Text="186"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#172033"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="24 đang sản xuất"
                                       Foreground="#1976D2"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>


                    <!-- HOÀN THÀNH -->

                    <Border Width="220"
                            Height="125"
                            Background="White"
                            BorderBrush="#E1E6EF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,15,15"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="Đã hoàn thành"
                                       Foreground="#7A8499"
                                       FontSize="13"/>

                            <TextBlock Text="162"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="#172033"
                                       Margin="0,8,0,0"/>

                            <TextBlock Text="87% tổng số lệnh"
                                       Foreground="#2E7D32"
                                       FontSize="12"/>

                        </StackPanel>

                    </Border>

                </WrapPanel>


                <!-- RECENT QUOTATIONS -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Báo giá gần đây"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,15"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Mã báo giá"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="1"
                                       Text="Khách hàng"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="2"
                                       Text="Giá trị"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="3"
                                       Text="Trạng thái"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                        </Grid>


                        <Border Height="1"
                                Background="#EEF1F5"
                                Margin="0,12"/>


                        <Grid Margin="0,5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BG001"
                                       Foreground="#1976D2"/>

                            <TextBlock Grid.Column="1"
                                       Text="Công ty A"
                                       Foreground="#253044"/>

                            <TextBlock Grid.Column="2"
                                       Text="25,000,000"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="3"
                                       Text="Đã duyệt"
                                       Foreground="#2E7D32"/>

                        </Grid>


                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="BG002"
                                       Foreground="#1976D2"/>

                            <TextBlock Grid.Column="1"
                                       Text="Công ty B"
                                       Foreground="#253044"/>

                            <TextBlock Grid.Column="2"
                                       Text="18,500,000"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="3"
                                       Text="Chờ duyệt"
                                       Foreground="#B26A00"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- PRODUCTION -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Tình hình sản xuất"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,15"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Text="Trạng thái"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="1"
                                       Text="Số lượng"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                            <TextBlock Grid.Column="2"
                                       Text="Tỷ lệ"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"/>

                        </Grid>


                        <Border Height="1"
                                Background="#EEF1F5"
                                Margin="0,12"/>


                        <Grid Margin="0,5">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Chờ sản xuất"/>

                            <TextBlock Grid.Column="1"
                                       Text="18"/>

                            <TextBlock Grid.Column="2"
                                       Text="10%"/>

                        </Grid>


                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Đang sản xuất"/>

                            <TextBlock Grid.Column="1"
                                       Text="24"/>

                            <TextBlock Grid.Column="2"
                                       Text="13%"/>

                        </Grid>


                        <Grid Margin="0,12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Hoàn thành"/>

                            <TextBlock Grid.Column="1"
                                       Text="144"/>

                            <TextBlock Grid.Column="2"
                                       Text="77%"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>