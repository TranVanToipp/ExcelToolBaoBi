<UserControl x:Class="ExcelTool.Features.Data.Create.SauIn.EpNhu_CanVan"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Màu nền -->
        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#D9E2F3"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#1F2937"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#FFFFFF"/>


        <!-- Label -->
        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="0,0,12,0"/>

        </Style>


        <!-- TextBox -->
        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ComboBox -->
        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- Card -->
        <Style x:Key="SectionCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="18"/>

        </Style>


        <!-- Thông tin phụ -->
        <Style x:Key="InfoTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TIÊU ĐỀ -->
        <!-- ===================================================== -->

        <TextBlock Grid.Row="0"
                   Text="Ép nhũ &amp; cán vân"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,4"/>


        <TextBlock Grid.Row="1"
                   Text="Khai báo ép nhũ và cán vân cho sản phẩm."
                   FontSize="13"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   Margin="0,0,0,16"/>


        <!-- ===================================================== -->
        <!-- ÉP NHŨ -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Style="{StaticResource SectionCardStyle}"
                Margin="0,0,0,16">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Tiêu đề -->
                    <RowDefinition Height="Auto"/>

                    <!-- Màu nhũ 01 -->
                    <RowDefinition Height="Auto"/>

                    <!-- Loại khuôn -->
                    <RowDefinition Height="Auto"/>

                    <!-- Màu nhũ 02 -->
                    <RowDefinition Height="Auto"/>

                    <!-- Khuôn nhũ 02 -->
                    <RowDefinition Height="Auto"/>

                    <!-- Màu nhũ 03 -->
                    <RowDefinition Height="Auto"/>

                    <!-- Khuôn nhũ 03 -->
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <!-- Nội dung bên trái -->
                    <ColumnDefinition Width="140"/>

                    <ColumnDefinition Width="*"/>

                    <!-- Nội dung bên phải -->
                    <ColumnDefinition Width="170"/>

                    <ColumnDefinition Width="170"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- TIÊU ĐỀ ÉP NHŨ -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="Ép nhũ"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,16"/>


                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,16">

                    <TextBlock Text="Đơn giá (VNĐ/sp):"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="0"
                               x:Name="FoilUnitPriceTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- MÀU NHŨ 01 -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Màu nhũ 01"
                           Style="{StaticResource FieldLabelStyle}"/>


                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          x:Name="FoilTypeComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,20,10"/>


                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Diện tích nhũ (cm²):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="1"
                         Grid.Column="3"
                         x:Name="FoilArea01TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- LOẠI KHUÔN -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Loại khuôn"
                           Style="{StaticResource FieldLabelStyle}"/>


                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          x:Name="FoilMoldType01ComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,20,10">

                    <ComboBoxItem Content="Khuôn mới"/>
                    <ComboBoxItem Content="Khuôn cũ"/>

                </ComboBox>


                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Tiền khuôn (VNĐ):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="2"
                         Grid.Column="3"
                         x:Name="FoilMoldPrice01TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"
                         Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- MÀU NHŨ 02 -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Màu nhũ 02"
                           Style="{StaticResource FieldLabelStyle}"/>


                <ComboBox Grid.Row="3"
                          Grid.Column="1"
                          x:Name="FoilType02ComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,20,10"/>


                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="Diện tích nhũ (cm²):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="3"
                         Grid.Column="3"
                         x:Name="FoilArea02TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- KHUÔN NHŨ 02 -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="4"
                           Grid.Column="0"
                           Text="Khuôn nhũ 02"
                           Style="{StaticResource FieldLabelStyle}"/>


                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         x:Name="FoilMold02TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,20,10"/>


                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Text="Tiền khuôn (VNĐ):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="4"
                         Grid.Column="3"
                         x:Name="FoilMoldPrice02TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"
                         Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- MÀU NHŨ 03 -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="5"
                           Grid.Column="0"
                           Text="Màu nhũ 03"
                           Style="{StaticResource FieldLabelStyle}"/>


                <ComboBox Grid.Row="5"
                          Grid.Column="1"
                          x:Name="FoilType03ComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,20,10"/>


                <TextBlock Grid.Row="5"
                           Grid.Column="2"
                           Text="Diện tích nhũ (cm²):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="5"
                         Grid.Column="3"
                         x:Name="FoilArea03TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- KHUÔN NHŨ 03 -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="6"
                           Grid.Column="0"
                           Text="Khuôn nhũ 03"
                           Style="{StaticResource FieldLabelStyle}"/>


                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         x:Name="FoilMold03TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,20,0"/>


                <TextBlock Grid.Row="6"
                           Grid.Column="2"
                           Text="Tiền khuôn (VNĐ):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="6"
                         Grid.Column="3"
                         x:Name="FoilMoldPrice03TextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CÁN VÂN -->
        <!-- ===================================================== -->

        <Border Grid.Row="3"
                Style="{StaticResource SectionCardStyle}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="140"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="170"/>

                    <ColumnDefinition Width="170"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- TIÊU ĐỀ CÁN VÂN -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Text="Cán vân"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,16"/>


                <StackPanel Grid.Row="0"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,16">

                    <TextBlock Text="Đơn giá (VNĐ/tờ):"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="0"
                               x:Name="EmbossUnitPriceTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- LOẠI VÂN -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Loại vân"
                           Style="{StaticResource FieldLabelStyle}"/>


                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          x:Name="EmbossTypeComboBox"
                          Style="{StaticResource InputComboBoxStyle}"
                          Margin="0,0,20,10">

                    <ComboBoxItem Content="Vân định vị"/>
                    <ComboBoxItem Content="Vân toàn phần"/>

                </ComboBox>


                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Giá khuôn (VNĐ):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="1"
                         Grid.Column="3"
                         x:Name="EmbossMoldPriceTextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"
                         Margin="0,0,0,10"/>


                <!-- ================================================= -->
                <!-- CÔNG CÁN VÂN -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="1"
                           Text="Công cán vân (VNĐ/m²)"
                           Style="{StaticResource FieldLabelStyle}"/>


                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         x:Name="EmbossPriceTextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         Margin="0,0,20,0"/>


                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Chi phí cán vân (VNĐ):"
                           Style="{StaticResource FieldLabelStyle}"
                           HorizontalAlignment="Right"/>


                <TextBox Grid.Row="2"
                         Grid.Column="3"
                         x:Name="EmbossCostTextBox"
                         Style="{StaticResource InputTextBoxStyle}"
                         IsReadOnly="True"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>