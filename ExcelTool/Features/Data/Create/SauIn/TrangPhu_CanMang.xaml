<UserControl x:Class="ExcelTool.Features.Data.Create.TrangPhu_CanMang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="PageBackgroundBrush"
                         Color="#F8FAFC"/>

        <SolidColorBrush x:Key="CardBackgroundBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryLightBrush"
                         Color="#EFF6FF"/>

        <SolidColorBrush x:Key="InputBackgroundBrush"
                         Color="#FFFFFF"/>


        <!-- ========================================================= -->
        <!-- FIELD LABEL -->
        <!-- ========================================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <!-- ========================================================= -->
        <!-- TEXTBOX -->
        <!-- ========================================================= -->

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ========================================================= -->
        <!-- COMBOBOX -->
        <!-- ========================================================= -->

        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Background"
                    Value="{StaticResource InputBackgroundBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <!-- ========================================================= -->
        <!-- CARD -->
        <!-- ========================================================= -->

        <Style x:Key="SectionCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="{StaticResource CardBackgroundBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="18"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>


        <!-- ========================================================= -->
        <!-- SMALL INFO -->
        <!-- ========================================================= -->

        <Style x:Key="InfoTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>

        </Style>

    </UserControl.Resources>


    <!-- ============================================================= -->
    <!-- ROOT -->
    <!-- ============================================================= -->

    <Grid Background="{StaticResource PageBackgroundBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- ================================================= -->
                <!-- TIÊU ĐỀ -->
                <!-- ================================================= -->

                <TextBlock Text="Tráng phủ &amp; cán màng"
                           FontSize="19"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Khai báo các lớp phủ và màng sử dụng cho sản phẩm."
                           Margin="0,6,0,20"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"/>


                <!-- ================================================= -->
                <!-- TRÁNG PHỦ -->
                <!-- ================================================= -->

                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="Tráng phủ"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Có thể khai báo tối đa 4 lần phủ."
                                   Margin="0,4,0,16"
                                   Style="{StaticResource InfoTextStyle}"/>


                        <!-- ================================================= -->
                        <!-- PHỦ LẦN 1 -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Phủ lần 1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabelStyle}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="CoatingTypeComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="CoatingTypeComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="3"
                                     x:Name="CoatingPriceTextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- PHỦ LẦN 2 -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Phủ lần 2"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabelStyle}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="CoatingType2ComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="CoatingType2ComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="3"
                                     x:Name="CoatingPrice2TextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- PHỦ LẦN 3 -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Phủ lần 3"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabelStyle}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="CoatingType3ComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="CoatingType3ComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="3"
                                     x:Name="CoatingPrice3TextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- PHỦ LẦN 4 -->
                        <!-- ================================================= -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Phủ lần 4"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource FieldLabelStyle}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="CoatingType4ComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="CoatingType4ComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="3"
                                     x:Name="CoatingPrice4TextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- CÁN MÀNG -->
                <!-- ================================================= -->

                <Border Style="{StaticResource SectionCardStyle}">

                    <StackPanel>

                        <TextBlock Text="Cán màng"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>

                        <TextBlock Text="Chọn loại màng cho từng mặt của sản phẩm."
                                   Margin="0,4,0,16"
                                   Style="{StaticResource InfoTextStyle}"/>


                        <!-- ================================================= -->
                        <!-- HEADER -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Vị trí"
                                       Style="{StaticResource InfoTextStyle}"/>


                            <TextBlock Grid.Column="1"
                                       Text="Loại màng"
                                       Style="{StaticResource InfoTextStyle}"/>


                            <TextBlock Grid.Column="2"
                                       Text="Đơn giá (VNĐ/m²)"
                                       Style="{StaticResource InfoTextStyle}"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- MẶT A -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Mặt A"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="FilmTypeComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="FilmTypeComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="2"
                                     x:Name="FilmUnitPriceTextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- MẶT B -->
                        <!-- ================================================= -->

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Mặt B"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="FilmTypeBComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="FilmTypeBComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="2"
                                     x:Name="FilmUnitPriceBTextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- MÀNG KHÁC -->
                        <!-- ================================================= -->

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Khác"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>


                            <ComboBox Grid.Column="1"
                                      x:Name="FilmTypeOtherComboBox"
                                      Style="{StaticResource InputComboBoxStyle}"
                                      IsEditable="False"
                                      SelectionChanged="FilmTypeOtherComboBox_SelectionChanged"/>


                            <TextBox Grid.Column="2"
                                     x:Name="FilmUnitPriceOtherTextBox"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     VerticalContentAlignment="Center"
                                     Text=""/>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>