<UserControl x:Class="ExcelTool.Features.Data.Create.CreateDataInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>


        <!-- ========================================================= -->
        <!-- LABEL -->
        <!-- ========================================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <!-- ========================================================= -->
        <!-- TEXTBOX -->
        <!-- ========================================================= -->

        <Style x:Key="InputTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>


        <!-- ========================================================= -->
        <!-- COMBOBOX -->
        <!-- ========================================================= -->

        <Style x:Key="InputComboBoxStyle"
               TargetType="ComboBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>


        <!-- ========================================================= -->
        <!-- DATEPICKER -->
        <!-- ========================================================= -->

        <Style x:Key="InputDatePickerStyle"
               TargetType="DatePicker">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Background"
                    Value="White"/>

        </Style>

    </UserControl.Resources>


    <!-- ============================================================= -->
    <!-- CONTENT -->
    <!-- ============================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Border Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24">

            <StackPanel>

                <!-- ================================================= -->
                <!-- TITLE -->
                <!-- ================================================= -->

                <TextBlock Text="Thông tin chung"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Thông tin cơ bản của sản phẩm và yêu cầu báo giá."
                           Margin="0,5,0,22"
                           FontSize="12"
                           Foreground="{StaticResource SecondaryTextBrush}"/>


                <!-- ================================================= -->
                <!-- FORM -->
                <!-- ================================================= -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- ============================================= -->
                    <!-- NGÀY LẬP -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,16">

                        <TextBlock Text="Ngày lập"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <DatePicker x:Name="CreatedDatePicker"
                                    Style="{StaticResource InputDatePickerStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- KHÁCH HÀNG -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="0"
                                Grid.Column="2"
                                Margin="0,0,0,16">

                        <TextBlock Text="Khách hàng"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="CustomerComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- TÊN SẢN PHẨM -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,0,16">

                        <TextBlock Text="Tên sản phẩm"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="ProductNameTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- NHÓM SẢN PHẨM -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,0,0,16">

                        <TextBlock Text="Nhóm sản phẩm"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="ProductTypeComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- QUY CÁCH -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,0,16">

                        <TextBlock Text="Quy cách"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="SpecificationTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- SỐ LƯỢNG -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="2"
                                Grid.Column="2"
                                Margin="0,0,0,16">

                        <TextBlock Text="Số lượng yêu cầu"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="QuantityTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- ĐỘ KHÓ -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,0,16">

                        <TextBlock Text="Độ khó sản phẩm"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="DifficultyComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- KIỂM SOÁT TÁI BẢN -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="3"
                                Grid.Column="2"
                                Margin="0,0,0,16">

                        <TextBlock Text="Kiểm soát tái bản"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="ReprintComboBox"
                                  Style="{StaticResource InputComboBoxStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- KHỔ TRẢI -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="0"
                                Margin="0,0,0,16">

                        <TextBlock Text="Khổ trải"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="SpreadSizeTextBox"
                                 Style="{StaticResource InputTextBoxStyle}"
                                 IsReadOnly="True"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- HẠN BÁO GIÁ -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="4"
                                Grid.Column="2"
                                Margin="0,0,0,16">

                        <TextBlock Text="Hạn báo giá"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <DatePicker x:Name="QuotationDeadlinePicker"
                                    Style="{StaticResource InputDatePickerStyle}"/>

                    </StackPanel>


                    <!-- ============================================= -->
                    <!-- GHI CHÚ -->
                    <!-- ============================================= -->

                    <StackPanel Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="3">

                        <TextBlock Text="Ghi chú"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <TextBox x:Name="NoteTextBox"
                                 MinHeight="100"
                                 Padding="10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 Background="White"/>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Border>

    </ScrollViewer>

</UserControl>