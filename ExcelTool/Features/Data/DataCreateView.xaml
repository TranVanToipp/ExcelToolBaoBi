<UserControl x:Class="ExcelTool.Features.Data.DataCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:create="clr-namespace:ExcelTool.Features.Data.Create"
             Background="Transparent">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#2563EB"/>

        <SolidColorBrush x:Key="PrimaryLightBrush"
                         Color="#EFF6FF"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E2E8F0"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#172033"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#64748B"/>


        <!-- ========================================================= -->
        <!-- STEP BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="StepButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </UserControl.Resources>


    <!-- ============================================================= -->
    <!-- MAIN -->
    <!-- ============================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,0,0,18">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <StackPanel>

                    <TextBlock Text="Tạo dữ liệu"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="Tạo mới thông tin sản phẩm"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"/>

                </StackPanel>


                <Button Grid.Column="1"
                        Content="Quay lại"
                        Width="100"
                        Height="36"
                        Margin="10,0,0,0"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Foreground="{StaticResource TextBrush}"
                        Cursor="Hand"
                        Click="BackButton_Click"/>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- STEP NAVIGATION -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="0,14">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- STEP 1 -->
                <!-- ================================================= -->

                <Button Grid.Column="0"
                        Style="{StaticResource StepButtonStyle}"
                        Background="{StaticResource PrimaryLightBrush}">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{StaticResource PrimaryBrush}">

                            <TextBlock Text="1"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="Thông tin chung"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <TextBlock Text="Thông tin sản phẩm"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- STEP 2 -->
                <!-- ================================================= -->

                <Button Grid.Column="1"
                        Style="{StaticResource StepButtonStyle}">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="#E2E8F0">

                            <TextBlock Text="2"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="Giấy &amp; In"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="Nguyên liệu và in"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- STEP 3 -->
                <!-- ================================================= -->

                <Button Grid.Column="2"
                        Style="{StaticResource StepButtonStyle}"
                        Click="Step3Button_Click">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="#E2E8F0">

                            <TextBlock Text="3"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="Sau in"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="Gia công sau in"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- STEP 4 -->
                <!-- ================================================= -->

                <Button Grid.Column="3"
                        Style="{StaticResource StepButtonStyle}">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="#E2E8F0">

                            <TextBlock Text="4"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="Thành phẩm"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="Thông tin đầu ra"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </Button>


                <!-- ================================================= -->
                <!-- STEP 5 -->
                <!-- ================================================= -->

                <Button Grid.Column="4"
                        Style="{StaticResource StepButtonStyle}">

                    <StackPanel Orientation="Horizontal">

                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="#E2E8F0">

                            <TextBlock Text="5"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel Margin="10,0,0,0">

                            <TextBlock Text="Tổng hợp giá"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="Tổng hợp chi phí"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- CONTENT -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Background="#F8FAFC"
                Padding="0,20,0,20">

            <ContentControl x:Name="StepContent"/>

        </Border>


        <!-- ========================================================= -->
        <!-- FOOTER -->
        <!-- ========================================================= -->

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,15">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock x:Name="StepStatusText"
                           Text="Bước 1 / 5 — Thông tin chung"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="12"/>


                <Button Grid.Column="1"
                    Content="Lưu và tiếp theo →"
                    Width="170"
                    Height="40"
                    Background="{StaticResource PrimaryBrush}"
                    BorderThickness="0"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="SaveButton_Click"/>

            </Grid>

        </Border>

    </Grid>

</UserControl>