<UserControl x:Class="ExcelTool.Features.Production.ProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Lệnh sản xuất"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Quản lý và theo dõi các lệnh sản xuất"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- TẠO LỆNH -->

            <Button Grid.Column="1"
                Content="+  Tạo lệnh sản xuất"
                Width="165"
                Height="42"
                Padding="15,0"
                Background="#1976D2"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="CreateProductionButton_Click"/>

        </Grid>


        <!-- ========================================== -->
        <!-- FILTER -->
        <!-- ========================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Margin="25,0,25,15"
                Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <Border Grid.Column="0"
                        Height="40"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,10,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="⌕"
                                   FontSize="20"
                                   Foreground="#7A8499"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"/>

                    </Grid>

                </Border>


                <!-- KHÁCH HÀNG -->

                <ComboBox Grid.Column="1"
                          Height="40"
                          Margin="0,0,10,0"
                          VerticalContentAlignment="Center"
                          FontSize="13">

                    <ComboBoxItem Content="Tất cả khách hàng"
                                  IsSelected="True"/>

                    <ComboBoxItem Content="Công ty A"/>

                    <ComboBoxItem Content="Công ty B"/>

                    <ComboBoxItem Content="NAM PHONG"/>

                </ComboBox>


                <!-- TRẠNG THÁI -->

                <ComboBox Grid.Column="2"
                          Height="40"
                          Margin="0,0,10,0"
                          VerticalContentAlignment="Center"
                          FontSize="13">

                    <ComboBoxItem Content="Tất cả trạng thái"
                                  IsSelected="True"/>

                    <ComboBoxItem Content="Chờ sản xuất"/>

                    <ComboBoxItem Content="Đang sản xuất"/>

                    <ComboBoxItem Content="Hoàn thành"/>

                    <ComboBoxItem Content="Đã hủy"/>

                </ComboBox>


                <!-- LỌC -->

                <Button Grid.Column="3"
                        Content="Lọc"
                        Width="70"
                        Height="40"
                        Background="#EEF5FD"
                        BorderBrush="#C7DCF5"
                        BorderThickness="1"
                        Foreground="#1976D2"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </Grid>

        </Border>


        <!-- ========================================== -->
        <!-- TABLE -->
        <!-- ========================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Margin="25,0,25,25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- TABLE HEADER -->

                <Border Grid.Row="0"
                        Background="#F8FAFD"
                        BorderBrush="#E1E6EF"
                        BorderThickness="0,0,0,1"
                        Padding="15,12">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="Mã lệnh"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="1"
                                   Text="Khách hàng"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="2"
                                   Text="Sản phẩm"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="3"
                                   Text="Số lượng"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="4"
                                   Text="Ngày sản xuất"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="5"
                                   Text="Trạng thái"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="6"
                                   Text="Thao tác"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                    </Grid>

                </Border>


                <!-- TABLE BODY -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>


                        <!-- ================================= -->
                        <!-- ROW 1 -->
                        <!-- ================================= -->

                        <Border BorderBrush="#EEF1F5"
                                BorderThickness="0,0,0,1"
                                Padding="15,12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="LSX001"
                                           FontWeight="SemiBold"
                                           Foreground="#1976D2"/>

                                <TextBlock Grid.Column="1"
                                           Text="Công ty A"
                                           Foreground="#253044"/>

                                <TextBlock Grid.Column="2"
                                           Text="HỘP CAO GAN"
                                           Foreground="#253044"/>

                                <TextBlock Grid.Column="3"
                                           Text="15,000"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="4"
                                           Text="10/04/2026"
                                           Foreground="#596579"/>


                                <Border Grid.Column="5"
                                        Background="#FFF4E5"
                                        CornerRadius="12"
                                        Padding="10,5"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="Chờ sản xuất"
                                               Foreground="#B26A00"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                </Border>


                                <StackPanel Grid.Column="6"
                                            Orientation="Horizontal">

                                    <Button Content="Xem"
                                        Width="55"
                                        Height="30"
                                        Margin="0,0,5,0"
                                        Background="Transparent"
                                        BorderBrush="#1976D2"
                                        BorderThickness="1"
                                        Foreground="#1976D2"
                                        Cursor="Hand"
                                        Tag="LSX001"
                                        Click="ProductionViewButton_Click"/>

                                    <Button Content="Sửa"
                                            Width="55"
                                            Height="30"
                                            Background="Transparent"
                                            BorderBrush="#D8DEE8"
                                            BorderThickness="1"
                                            Foreground="#596579"
                                            Cursor="Hand"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ================================= -->
                        <!-- ROW 2 -->
                        <!-- ================================= -->

                        <Border BorderBrush="#EEF1F5"
                                BorderThickness="0,0,0,1"
                                Padding="15,12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="LSX002"
                                           FontWeight="SemiBold"
                                           Foreground="#1976D2"/>

                                <TextBlock Grid.Column="1"
                                           Text="Công ty B"
                                           Foreground="#253044"/>

                                <TextBlock Grid.Column="2"
                                           Text="TÚI GIẤY"
                                           Foreground="#253044"/>

                                <TextBlock Grid.Column="3"
                                           Text="20,000"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="4"
                                           Text="11/04/2026"
                                           Foreground="#596579"/>


                                <Border Grid.Column="5"
                                        Background="#E8F1FC"
                                        CornerRadius="12"
                                        Padding="10,5"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="Đang sản xuất"
                                               Foreground="#1976D2"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                </Border>


                                <StackPanel Grid.Column="6"
                                            Orientation="Horizontal">

                                    <Button Content="Xem"
                                            Width="55"
                                            Height="30"
                                            Margin="0,0,5,0"
                                            Background="Transparent"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Foreground="#1976D2"
                                            Cursor="Hand"/>

                                    <Button Content="Sửa"
                                            Width="55"
                                            Height="30"
                                            Background="Transparent"
                                            BorderBrush="#D8DEE8"
                                            BorderThickness="1"
                                            Foreground="#596579"
                                            Cursor="Hand"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ================================= -->
                        <!-- ROW 3 -->
                        <!-- ================================= -->

                        <Border BorderBrush="#EEF1F5"
                                BorderThickness="0,0,0,1"
                                Padding="15,12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="LSX003"
                                           FontWeight="SemiBold"
                                           Foreground="#1976D2"/>

                                <TextBlock Grid.Column="1"
                                           Text="NAM PHONG"
                                           Foreground="#253044"/>

                                <TextBlock Grid.Column="2"
                                           Text="HỘP MỸ PHẨM"
                                           Foreground="#253044"/>

                                <TextBlock Grid.Column="3"
                                           Text="10,000"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="4"
                                           Text="12/04/2026"
                                           Foreground="#596579"/>


                                <Border Grid.Column="5"
                                        Background="#E8F5E9"
                                        CornerRadius="12"
                                        Padding="10,5"
                                        HorizontalAlignment="Left">

                                    <TextBlock Text="Hoàn thành"
                                               Foreground="#2E7D32"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>

                                </Border>


                                <StackPanel Grid.Column="6"
                                            Orientation="Horizontal">

                                    <Button Content="Xem"
                                            Width="55"
                                            Height="30"
                                            Margin="0,0,5,0"
                                            Background="Transparent"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Foreground="#1976D2"
                                            Cursor="Hand"/>

                                    <Button Content="Sửa"
                                            Width="55"
                                            Height="30"
                                            Background="Transparent"
                                            BorderBrush="#D8DEE8"
                                            BorderThickness="1"
                                            Foreground="#596579"
                                            Cursor="Hand"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>