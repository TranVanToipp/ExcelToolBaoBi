<UserControl x:Class="ExcelTool.Features.Production.ProductionCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="Tạo lệnh sản xuất"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Nhập thông tin để tạo lệnh sản xuất mới"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- QUAY LẠI -->

            <Button Grid.Column="1"
                    Content="←  Quay lại"
                    Width="110"
                    Height="40"
                    Background="White"
                    BorderBrush="#1976D2"
                    BorderThickness="1"
                    Foreground="#1976D2"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- ========================================== -->
        <!-- FORM -->
        <!-- ========================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25,0,25,25">


                <!-- ========================================== -->
                <!-- THÔNG TIN LỆNH -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin lệnh sản xuất"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>


                            <!-- KHÁCH HÀNG -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Khách hàng *"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Height="38"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Chọn khách hàng..."
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Công ty A"/>

                                <ComboBoxItem Content="Công ty B"/>

                                <ComboBoxItem Content="NAM PHONG"/>

                            </ComboBox>


                            <!-- NGÀY LẬP -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Ngày lập"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <DatePicker Grid.Row="0"
                                        Grid.Column="3"
                                        Height="38"
                                        VerticalContentAlignment="Center"/>


                            <!-- BÁO GIÁ -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Báo giá"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Height="38"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Chọn báo giá..."
                                              IsSelected="True"/>

                                <ComboBoxItem Content="BG001 - Công ty A"/>

                                <ComboBoxItem Content="BG002 - Công ty B"/>

                            </ComboBox>


                            <!-- NGÀY SẢN XUẤT -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Ngày sản xuất *"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <DatePicker Grid.Row="1"
                                        Grid.Column="3"
                                        Height="38"
                                        VerticalContentAlignment="Center"/>


                            <!-- NGÀY GIAO -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Ngày giao dự kiến"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <DatePicker Grid.Row="2"
                                        Grid.Column="1"
                                        Height="38"
                                        Margin="0,0,20,0"
                                        VerticalContentAlignment="Center"/>


                            <!-- ƯU TIÊN -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Mức ưu tiên"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="2"
                                      Grid.Column="3"
                                      Height="38"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Bình thường"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Ưu tiên"/>

                                <ComboBoxItem Content="Gấp"/>

                            </ComboBox>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ========================================== -->
                <!-- THÔNG TIN SẢN PHẨM -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin sản phẩm"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>


                            <!-- SẢN PHẨM -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Sản phẩm *"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      Height="38"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Chọn sản phẩm..."
                                              IsSelected="True"/>

                                <ComboBoxItem Content="HỘP CAO GAN"/>

                                <ComboBoxItem Content="TÚI GIẤY"/>

                                <ComboBoxItem Content="HỘP MỸ PHẨM"/>

                            </ComboBox>


                            <!-- SỐ LƯỢNG -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Số lượng *"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <TextBox Grid.Row="0"
                                     Grid.Column="3"
                                     Height="38"
                                     Text="0"
                                     VerticalContentAlignment="Center"/>


                            <!-- KHỔ GIẤY -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Khổ giấy"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Height="38"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Chọn khổ giấy..."
                                              IsSelected="True"/>

                                <ComboBoxItem Content="65 x 86 cm"/>

                                <ComboBoxItem Content="79 x 109 cm"/>

                                <ComboBoxItem Content="72 x 102 cm"/>

                            </ComboBox>


                            <!-- SỐ SP / TỜ -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Sản phẩm / tờ"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Height="38"
                                     Text="0"
                                     VerticalContentAlignment="Center"/>


                            <!-- CÔNG NGHỆ IN -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Công nghệ in"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      Height="38"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Chọn công nghệ..."
                                              IsSelected="True"/>

                                <ComboBoxItem Content="In Offset"/>

                                <ComboBoxItem Content="In Flexo"/>

                                <ComboBoxItem Content="In kỹ thuật số"/>

                            </ComboBox>


                            <!-- SỐ MÀU -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Số màu"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox Grid.Row="2"
                                      Grid.Column="3"
                                      Height="38"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="1 màu"/>

                                <ComboBoxItem Content="2 màu"/>

                                <ComboBoxItem Content="3 màu"/>

                                <ComboBoxItem Content="4 màu"
                                              IsSelected="True"/>

                            </ComboBox>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ========================================== -->
                <!-- GIA CÔNG -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Công đoạn gia công"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <WrapPanel>

                            <CheckBox Content="Cán màng"
                                      FontSize="14"
                                      Margin="0,0,30,15"/>

                            <CheckBox Content="Bế"
                                      FontSize="14"
                                      Margin="0,0,30,15"/>

                            <CheckBox Content="Dán"
                                      FontSize="14"
                                      Margin="0,0,30,15"/>

                            <CheckBox Content="Ép kim"
                                      FontSize="14"
                                      Margin="0,0,30,15"/>

                            <CheckBox Content="UV"
                                      FontSize="14"
                                      Margin="0,0,30,15"/>

                            <CheckBox Content="Đóng gói"
                                      FontSize="14"
                                      Margin="0,0,30,15"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>


                <!-- ========================================== -->
                <!-- GHI CHÚ -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Ghi chú sản xuất"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBox Height="100"
                                 Margin="0,15,0,0"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"/>

                    </StackPanel>

                </Border>


                <!-- ========================================== -->
                <!-- BUTTON -->
                <!-- ========================================== -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Hủy"
                            Width="100"
                            Height="42"
                            Margin="0,0,10,0"
                            Background="White"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            Foreground="#596579"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                    <Button Content="Tạo lệnh sản xuất"
                            Width="155"
                            Height="42"
                            Background="#1976D2"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>