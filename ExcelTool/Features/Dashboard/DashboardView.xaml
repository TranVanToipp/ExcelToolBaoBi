<UserControl x:Class="ExcelTool.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ExcelTool.Shared.Controls">

    <UserControl.Resources>

        <!-- ================================================= -->
        <!-- CARD SHADOW -->
        <!-- ================================================= -->

        <DropShadowEffect
            x:Key="CardShadow"
            BlurRadius="12"
            ShadowDepth="2"
            Opacity="0.12"/>


        <!-- ================================================= -->
        <!-- QUICK ACTION BUTTON -->
        <!-- ================================================= -->

        <Style x:Key="QuickActionButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="Foreground"
                    Value="#1F2937"/>

            <Setter Property="BorderBrush"
                    Value="#E5E7EB"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Height"
                    Value="62"/>

            <Setter Property="Margin"
                    Value="5"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="15">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F1F7FF"/>

                    <Setter Property="BorderBrush"
                            Value="#1677D2"/>

                    <Setter Property="Foreground"
                            Value="#1677D2"/>

                </Trigger>

                <Trigger Property="IsPressed"
                         Value="True">

                    <Setter Property="Background"
                            Value="#E3F0FF"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- ================================================= -->
    <!-- MAIN -->
    <!-- ================================================= -->

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="25">


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextBlock
                Text="Tổng quan"
                FontSize="30"
                FontWeight="Bold"
                Foreground="#111827"/>

            <TextBlock
                Text="Chào mừng trở lại! 👋"
                Margin="0,5,0,25"
                FontSize="15"
                Foreground="#6B7280"/>


            <!-- ================================================= -->
            <!-- STATISTICS -->
            <!-- ================================================= -->

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- Excel Files -->

                <controls:StatisticCard
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Title="Tệp Excel"
                    Value="125"
                    Subtitle="+12 Today"/>


                <!-- Templates -->

                <controls:StatisticCard
                    Grid.Column="1"
                    Margin="10,0"
                    Title="Đã cài đặt"
                    Value="8"
                    Subtitle="Installed"/>


                <!-- History -->

                <controls:StatisticCard
                    Grid.Column="2"
                    Margin="10,0"
                    Title="Lịch sử"
                    Value="523"
                    Subtitle="Processed"/>


                <!-- License -->

                <controls:StatisticCard
                    Grid.Column="3"
                    Margin="10,0,0,0"
                    Title="Giấy phép"
                    Value="PRO"
                    Subtitle="Unlimited"/>

            </Grid>


            <!-- ================================================= -->
            <!-- QUICK ACTIONS -->
            <!-- ================================================= -->

            <!-- ================================================= -->
            <!-- QUICK ACTIONS -->
            <!-- ================================================= -->

            <Border
    Margin="0,30,0,0"
    Background="White"
    CornerRadius="10"
    BorderBrush="#E5E7EB"
    BorderThickness="1"
    Effect="{StaticResource CardShadow}">

                <StackPanel>

                    <!-- Header -->

                    <Border
            Background="#1677D2"
            CornerRadius="10,10,0,0"
            Padding="12,9">

                        <TextBlock
                Text="Thao tác nhanh"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="White"/>

                    </Border>


                    <!-- Buttons -->

                    <WrapPanel Margin="15">

                        <!-- ========================= -->
                        <!-- NHẬP DỮ LIỆU -->
                        <!-- ========================= -->

                        <Button
                x:Name="ImportButton"
                Click="ImportButton_Click"
                Style="{StaticResource QuickActionButton}"
                Width="165">

                            <StackPanel
                    Orientation="Horizontal">

                                <TextBlock
                        Text="&#xE896;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="#1677D2"
                        VerticalAlignment="Center"/>

                                <TextBlock
                        Text="Nhập dữ liệu"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- ========================= -->
                        <!-- XUẤT DỮ LIỆU -->
                        <!-- ========================= -->

                        <Button
                x:Name="ExportButton"
                Click="ExportButton_Click"
                Style="{StaticResource QuickActionButton}"
                Width="165">

                            <StackPanel
                    Orientation="Horizontal">

                                <TextBlock
                        Text="&#xEDE1;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="#1677D2"
                        VerticalAlignment="Center"/>

                                <TextBlock
                        Text="Xuất dữ liệu"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- ========================= -->
                        <!-- LỊCH SỬ -->
                        <!-- ========================= -->

                        <Button
                x:Name="HistoryButton"
                Click="HistoryButton_Click"
                Style="{StaticResource QuickActionButton}"
                Width="150">

                            <StackPanel
                    Orientation="Horizontal">

                                <TextBlock
                        Text="&#xE81C;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="#1677D2"
                        VerticalAlignment="Center"/>

                                <TextBlock
                        Text="Lịch sử"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <!-- ========================= -->
                        <!-- CÀI ĐẶT -->
                        <!-- ========================= -->

                        <Button
                x:Name="SettingsButton"
                Click="SettingsButton_Click"
                Style="{StaticResource QuickActionButton}"
                Width="150">

                            <StackPanel
                    Orientation="Horizontal">

                                <TextBlock
                        Text="&#xE713;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="#1677D2"
                        VerticalAlignment="Center"/>

                                <TextBlock
                        Text="Cài đặt"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </WrapPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- RECENT ACTIVITY -->
            <!-- ================================================= -->

            <Border
                Margin="0,30,0,0"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}">


                <StackPanel>


                    <!-- Header -->

                    <Border
                        Background="#1677D2"
                        CornerRadius="10,10,0,0"
                        Padding="12,9">

                        <TextBlock
                            Text="Recent Activity"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="White"/>

                    </Border>


                    <!-- Activity List -->

                    <StackPanel Margin="15,10">


                        <!-- Item 1 -->

                        <Border
                            Padding="10"
                            Margin="0,0,0,4"
                            Background="Transparent">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E8F2FF">

                                    <TextBlock
                                        Text="&#xE73E;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="#1677D2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock
                                    Grid.Column="1"
                                    Text="Import Customer.xlsx"
                                    VerticalAlignment="Center"
                                    Foreground="#374151"/>


                                <TextBlock
                                    Grid.Column="2"
                                    Text="10:15 AM"
                                    Foreground="#9CA3AF"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <!-- Item 2 -->

                        <Border
                            Padding="10"
                            Margin="0,0,0,4">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E8F2FF">

                                    <TextBlock
                                        Text="&#xE73E;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="#1677D2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock
                                    Grid.Column="1"
                                    Text="Export Report.xlsx"
                                    VerticalAlignment="Center"
                                    Foreground="#374151"/>


                                <TextBlock
                                    Grid.Column="2"
                                    Text="09:47 AM"
                                    Foreground="#9CA3AF"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <!-- Item 3 -->

                        <Border
                            Padding="10"
                            Margin="0,0,0,4">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E8F2FF">

                                    <TextBlock
                                        Text="&#xE73E;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="#1677D2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock
                                    Grid.Column="1"
                                    Text="Backup Database"
                                    VerticalAlignment="Center"
                                    Foreground="#374151"/>


                                <TextBlock
                                    Grid.Column="2"
                                    Text="09:32 AM"
                                    Foreground="#9CA3AF"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <!-- Item 4 -->

                        <Border
                            Padding="10">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>


                                <Border
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E8F2FF">

                                    <TextBlock
                                        Text="&#xE73E;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="#1677D2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock
                                    Grid.Column="1"
                                    Text="Load Template"
                                    VerticalAlignment="Center"
                                    Foreground="#374151"/>


                                <TextBlock
                                    Grid.Column="2"
                                    Text="09:12 AM"
                                    Foreground="#9CA3AF"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                    </StackPanel>


                    <!-- View All -->

                    <Border
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,1,0,0"
                        Padding="15">

                        <TextBlock
                            Text="Xem tất cả hoạt động  ›"
                            Foreground="#1677D2"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Cursor="Hand"/>

                    </Border>

                </StackPanel>

            </Border>


        </StackPanel>

    </ScrollViewer>

</UserControl>