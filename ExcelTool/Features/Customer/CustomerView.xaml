<UserControl x:Class="ExcelTool.Features.Customer.CustomerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="25,25,25,15">

            <TextBlock Text="Khách hàng"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172033"/>

            <TextBlock Text="Quản lý danh mục khách hàng"
                       Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#7A8499"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- TOOLBAR -->
        <!-- ================================================= -->

        <Grid Grid.Row="1"
              Margin="25,0,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- SEARCH -->

            <Border Grid.Column="0"
                    Height="42"
                    MaxWidth="450"
                    Background="White"
                    BorderBrush="#E1E6EF"
                    BorderThickness="1"
                    CornerRadius="8">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="⌕"
                               FontSize="24"
                               Foreground="#7A8499"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>


                    <TextBox
                        x:Name="SearchCustomer"
                        Grid.Column="1"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        ToolTip="Tìm kiếm theo mã, tên khách hàng, người liên hệ, số điện thoại..."
                        TextChanged="SearchCustomer_TextChanged"/>

                </Grid>

            </Border>


            <!-- ADD CUSTOMER -->

            <Button Grid.Column="1"
                Margin="15,0,0,0"
                Height="42"
                Padding="20,0"
                Background="#1976D2"
                Foreground="White"
                BorderThickness="0"
                FontSize="14"
                FontWeight="SemiBold"
                Cursor="Hand"
                Content="+  Thêm khách hàng"
                Click="AddCustomer_Click"/>

        </Grid>


        <!-- ================================================= -->
        <!-- CUSTOMER TABLE -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Margin="25,0,25,25"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E1E6EF"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- ================================================= -->
                <!-- TABLE HEADER -->
                <!-- ================================================= -->

                <Border Grid.Row="0"
                        Background="#F8FAFD"
                        BorderBrush="#E1E6EF"
                        BorderThickness="0,0,0,1">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <!-- ID -->
                            <ColumnDefinition Width="70"/>

                            <!-- Short Name -->
                            <ColumnDefinition Width="150"/>

                            <!-- Full Name -->
                            <ColumnDefinition Width="*"/>

                            <!-- Contact -->
                            <ColumnDefinition Width="160"/>

                            <!-- Phone -->
                            <ColumnDefinition Width="140"/>

                            <!-- Action -->
                            <ColumnDefinition Width="100"/>

                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="ID"
                                   Margin="15,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>


                        <TextBlock Grid.Column="1"
                                   Text="Tên viết tắt"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>


                        <TextBlock Grid.Column="2"
                                   Text="Tên đầy đủ"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>


                        <TextBlock Grid.Column="3"
                                   Text="Người liên hệ"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>


                        <TextBlock Grid.Column="4"
                                   Text="Điện thoại"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>


                        <TextBlock Grid.Column="5"
                                   Text="Chi tiết"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- CUSTOMER DATA -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>


                        <ItemsControl x:Name="CustomerList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border
                Height="60"
                BorderBrush="#EEF1F5"
                BorderThickness="0,0,0,1">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="130"/>

                                            </Grid.ColumnDefinitions>


                                            <!-- ID -->

                                            <TextBlock
                        Grid.Column="0"
                        Text="{Binding Id}"
                        Margin="15,0"
                        VerticalAlignment="Center"
                        Foreground="#1976D2"
                        FontWeight="SemiBold"/>


                                            <!-- TÊN VIẾT TẮT -->

                                            <TextBlock
                        Grid.Column="1"
                        Text="{Binding ShortName}"
                        VerticalAlignment="Center"
                        Foreground="#253044"/>


                                            <!-- TÊN ĐẦY ĐỦ -->

                                            <TextBlock
                        Grid.Column="2"
                        Text="{Binding FullName}"
                        VerticalAlignment="Center"
                        Foreground="#253044"
                        TextTrimming="CharacterEllipsis"/>


                                            <!-- NGƯỜI LIÊN HỆ -->

                                            <TextBlock
                        Grid.Column="3"
                        Text="{Binding ContactPerson}"
                        VerticalAlignment="Center"
                        Foreground="#596579"/>


                                            <!-- ĐIỆN THOẠI -->

                                            <TextBlock
                        Grid.Column="4"
                        Text="{Binding Phone}"
                        VerticalAlignment="Center"
                        Foreground="#596579"/>


                                            <!-- CHI TIẾT -->

                                            <StackPanel
    Grid.Column="5"
    Orientation="Horizontal"
    VerticalAlignment="Center">

                                                <Button
        Content="Xem"
        Width="55"
        Height="30"
        Background="Transparent"
        BorderBrush="#1976D2"
        BorderThickness="1"
        Foreground="#1976D2"
        Cursor="Hand"
        Margin="0,0,5,0"
        Click="CustomerDetail_Click"/>

                                                <Button
        Content="Xóa"
        Width="55"
        Height="30"
        Background="Transparent"
        BorderBrush="#D32F2F"
        BorderThickness="1"
        Foreground="#D32F2F"
        Cursor="Hand"
        Click="DeleteCustomer_Click"/>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>