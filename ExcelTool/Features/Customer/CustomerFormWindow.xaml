<Window x:Class="ExcelTool.Features.Customer.CustomerFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm khách hàng"
        Width="700"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Margin="15"
            Background="White"
            CornerRadius="12"
            BorderBrush="#E1E6EF"
            BorderThickness="1">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================= HEADER ================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,25">

                <TextBlock Text="Thêm khách hàng"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Nhập thông tin khách hàng mới"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- ================= FORM ================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- TÊN VIẾT TẮT -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Tên viết tắt *"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"
                               Margin="0,0,15,18"/>

                    <TextBox x:Name="ShortNameTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"
                             Margin="0,0,0,18"/>


                    <!-- TÊN ĐẦY ĐỦ -->

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Tên đầy đủ *"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"
                               Margin="0,0,15,18"/>

                    <TextBox x:Name="FullNameTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"
                             Margin="0,0,0,18"/>


                    <!-- ĐỊA CHỈ -->

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Địa chỉ"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"
                               Margin="0,0,15,18"/>

                    <TextBox x:Name="AddressTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"
                             Margin="0,0,0,18"/>


                    <!-- MÃ SỐ THUẾ -->

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Mã số thuế"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"
                               Margin="0,0,15,18"/>

                    <TextBox x:Name="TaxCodeTextBox"
                             Grid.Row="3"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"
                             Margin="0,0,0,18"/>


                    <!-- NGƯỜI LIÊN HỆ -->

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Người liên hệ"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"
                               Margin="0,0,15,18"/>

                    <TextBox x:Name="ContactTextBox"
                             Grid.Row="4"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"
                             Margin="0,0,0,18"/>


                    <!-- EMAIL -->

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Email"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"
                               Margin="0,0,15,18"/>

                    <TextBox x:Name="EmailTextBox"
                             Grid.Row="5"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"
                             Margin="0,0,0,18"/>


                    <!-- ĐIỆN THOẠI -->

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Điện thoại"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="PhoneTextBox"
                             Grid.Row="6"
                             Grid.Column="1"
                             Height="38"
                             Padding="10,0"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             BorderBrush="#D5DBE5"
                             BorderThickness="1"/>

                </Grid>

            </ScrollViewer>


            <!-- ================= FOOTER ================= -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,25,0,0">

                <Button Content="Hủy"
                        Width="90"
                        Height="38"
                        Background="Transparent"
                        BorderBrush="#D5DBE5"
                        BorderThickness="1"
                        Foreground="#596579"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"/>

                <Button Content="Lưu khách hàng"
                        Width="145"
                        Height="38"
                        Background="#1976D2"
                        BorderThickness="0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>