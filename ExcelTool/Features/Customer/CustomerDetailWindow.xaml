<Window x:Class="ExcelTool.Features.Customer.CustomerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin khách hàng"
        Width="650"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FB">

    <Border Margin="15"
            Background="White"
            CornerRadius="12"
            BorderBrush="#E1E6EF"
            BorderThickness="1">

        <Grid Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================= HEADER ================= -->

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">

                <TextBlock Text="Thông tin khách hàng"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Chi tiết thông tin khách hàng"
                           Margin="0,5,0,0"
                           FontSize="13"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- ================= INFORMATION ================= -->

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ID -->

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="ID"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="IdText"
                               Grid.Row="0"
                               Grid.Column="1"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Tên viết tắt -->

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Tên viết tắt"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="ShortNameText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Tên đầy đủ -->

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Tên đầy đủ"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="FullNameText"
                               Grid.Row="2"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Địa chỉ -->

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Text="Địa chỉ"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="AddressText"
                               Grid.Row="3"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Mã số thuế -->

                    <TextBlock Grid.Row="4"
                               Grid.Column="0"
                               Text="Mã số thuế"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="TaxCodeText"
                               Grid.Row="4"
                               Grid.Column="1"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Người liên hệ -->

                    <TextBlock Grid.Row="5"
                               Grid.Column="0"
                               Text="Người liên hệ"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="ContactText"
                               Grid.Row="5"
                               Grid.Column="1"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Email -->

                    <TextBlock Grid.Row="6"
                               Grid.Column="0"
                               Text="Email"
                               FontWeight="SemiBold"
                               Foreground="#596579"
                               Margin="0,0,0,18"/>

                    <TextBlock x:Name="EmailText"
                               Grid.Row="6"
                               Grid.Column="1"
                               Foreground="#253044"
                               Margin="0,0,0,18"/>


                    <!-- Điện thoại -->

                    <TextBlock Grid.Row="7"
                               Grid.Column="0"
                               Text="Điện thoại"
                               FontWeight="SemiBold"
                               Foreground="#596579"/>

                    <TextBlock x:Name="PhoneText"
                               Grid.Row="7"
                               Grid.Column="1"
                               Foreground="#253044"/>

                </Grid>

            </ScrollViewer>


            <!-- ================= FOOTER ================= -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">

                    <Button Content="Đóng"
            Width="90"
            Height="36"
            Background="Transparent"
            BorderBrush="#D5DBE5"
            BorderThickness="1"
            Foreground="#596579"
            Cursor="Hand"
            Margin="0,0,10,0"
            Click="CloseButton_Click"/>

                    <Button Content="Sửa"
            Width="90"
            Height="36"
            Background="#1976D2"
            BorderThickness="0"
            Foreground="White"
            FontWeight="SemiBold"
            Cursor="Hand"
            Click="EditButton_Click"/>

                </StackPanel>

            </StackPanel>

        </Grid>

    </Border>

</Window>