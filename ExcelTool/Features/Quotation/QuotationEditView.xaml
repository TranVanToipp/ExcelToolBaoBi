<UserControl x:Class="ExcelTool.Features.Quotation.QuotationEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="Sửa báo giá"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Chỉnh sửa thông tin báo giá"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- MÃ BÁO GIÁ -->

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#E1E6EF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="15,8"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Mã báo giá"
                               FontSize="11"
                               Foreground="#7A8499"/>

                    <TextBlock x:Name="QuotationIdText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#1976D2"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25,0,25,20">


                <!-- ================================================= -->
                <!-- THÔNG TIN KHÁCH HÀNG -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin khách hàng"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>


                            <!-- KHÁCH HÀNG -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Khách hàng *"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"
                                       VerticalAlignment="Center"/>

                            <ComboBox x:Name="CustomerComboBox"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="3"
                                      Height="38"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="FullName"
                                      SelectionChanged="CustomerComboBox_SelectionChanged"/>


                            <!-- NGƯỜI LIÊN HỆ -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Người liên hệ"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="ContactTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>


                            <!-- ĐIỆN THOẠI -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Điện thoại"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="PhoneTextBox"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"/>


                            <!-- NGÀY LẬP -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Ngày lập"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="CreatedDateTextBox"
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Background="#F8FAFD"/>


                            <!-- TRẠNG THÁI -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Trạng thái"
                                       FontWeight="SemiBold"
                                       Foreground="#596579"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="StatusTextBox"
                                     Grid.Row="2"
                                     Grid.Column="3"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Background="#F8FAFD"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- SẢN PHẨM -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <Grid Margin="0,0,0,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>


                            <TextBlock Text="Chi tiết sản phẩm"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#172033"
                                       VerticalAlignment="Center"/>


                            <Button Grid.Column="1"
                                    Content="+  Thêm sản phẩm"
                                    Width="130"
                                    Height="36"
                                    Background="#EEF5FD"
                                    BorderBrush="#C7DCF5"
                                    BorderThickness="1"
                                    Foreground="#1976D2"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="AddProductButton_Click"/>

                        </Grid>


                        <!-- HEADER -->

                        <Border Background="#F8FAFD"
                                Padding="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Sản phẩm"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="1"
                                           Text="Số lượng"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="2"
                                           Text="Đơn giá"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="3"
                                           Text="Thành tiền"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="4"
                                           Text=""
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                            </Grid>

                        </Border>


                        <!-- DANH SÁCH SẢN PHẨM -->

                        <StackPanel x:Name="ProductRowsPanel"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- TỔNG TIỀN -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>


                        <!-- GHI CHÚ -->

                        <StackPanel>

                            <TextBlock Text="Ghi chú"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#172033"/>

                            <TextBox x:Name="NoteTextBox"
                                     Height="100"
                                     Margin="0,10,20,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"
                                     Padding="10"/>

                        </StackPanel>


                        <!-- TỔNG -->

                        <StackPanel Grid.Column="1">

                            <Grid Margin="0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tạm tính"
                                           Foreground="#596579"/>

                                <TextBlock x:Name="SubTotalText"
                                           Grid.Column="1"
                                           Foreground="#172033"/>

                            </Grid>


                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Chiết khấu"
                                           Foreground="#596579"/>

                                <TextBox x:Name="DiscountTextBox"
                                         Grid.Column="1"
                                         Width="120"
                                         Height="32"
                                         Padding="8,0"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         TextChanged="DiscountTextBox_TextChanged"/>

                            </Grid>


                            <Border Height="1"
                                    Background="#E1E6EF"
                                    Margin="0,8"/>


                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tổng cộng"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#172033"/>

                                <TextBlock x:Name="TotalAmountText"
                                           Grid.Column="1"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"/>

                            </Grid>

                        </StackPanel>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1,1,1,0"
                Padding="25,15">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Hủy"
                        Width="90"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="Transparent"
                        BorderBrush="#D5DBE5"
                        BorderThickness="1"
                        Foreground="#596579"
                        Cursor="Hand"
                        Click="BackButton_Click"/>

                <Button Content="Lưu thay đổi"
                        Width="130"
                        Height="40"
                        Background="#1976D2"
                        BorderThickness="0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SaveButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>