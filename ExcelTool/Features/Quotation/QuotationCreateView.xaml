<UserControl x:Class="ExcelTool.Features.Quotation.QuotationCreateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="Tạo báo giá"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Nhập thông tin để tạo báo giá mới"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- QUAY LẠI -->

            <Button Grid.Column="1"
                    Content="←  Quay lại"
                    Width="110"
                    Height="40"
                    Background="White"
                    BorderBrush="#1976D2"
                    BorderThickness="1"
                    Foreground="#1976D2"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BackButton_Click"/>

        </Grid>


        <!-- ========================================== -->
        <!-- FORM -->
        <!-- ========================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25,0,25,25">


                <!-- ========================================== -->
                <!-- THÔNG TIN KHÁCH HÀNG -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin khách hàng"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                            </Grid.RowDefinitions>


                            <!-- KHÁCH HÀNG -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Khách hàng *"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <ComboBox x:Name="CustomerComboBox"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      Height="38"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center"
                                      DisplayMemberPath="FullName"
                                      SelectedValuePath="Id"
                                      SelectionChanged="CustomerComboBox_SelectionChanged"/>


                            <!-- NGÀY -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Ngày lập"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <DatePicker x:Name="CreatedDatePicker"
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        Height="38"
                                        VerticalContentAlignment="Center"/>


                            <!-- NGƯỜI LIÊN HỆ -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Người liên hệ"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <TextBox x:Name="ContactTextBox"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="38"
                                     Margin="0,0,20,0"
                                     VerticalContentAlignment="Center"/>


                            <!-- ĐIỆN THOẠI -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Điện thoại"
                                       VerticalAlignment="Center"
                                       Foreground="#596579"/>

                            <TextBox x:Name="PhoneTextBox"
                                     Grid.Row="1"
                                     Grid.Column="3"
                                     Height="38"
                                     VerticalContentAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ========================================== -->
                <!-- THÔNG TIN SẢN PHẨM -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <Grid Margin="0,0,0,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Thông tin sản phẩm"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#172033"/>

                            <Button Grid.Column="1"
                                    Content="+  Thêm sản phẩm"
                                    Width="130"
                                    Height="36"
                                    Background="#EEF5FD"
                                    BorderBrush="#C7DCF5"
                                    BorderThickness="1"
                                    Foreground="#1976D2"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="AddProductButton_Click"/>

                        </Grid>


                        <!-- HEADER -->

                        <Border Background="#F8FAFD"
                                Padding="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Sản phẩm"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="1"
                                           Text="Số lượng"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="2"
                                           Text="Đơn giá"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="3"
                                           Text="Thành tiền"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="4"
                                           Text=""
                                           FontWeight="SemiBold"/>

                            </Grid>

                        </Border>


                        <!-- DANH SÁCH SẢN PHẨM -->

                        <StackPanel x:Name="ProductRowsPanel"/>

                    </StackPanel>

                </Border>


                <!-- ========================================== -->
                <!-- GIÁ VÀ GHI CHÚ -->
                <!-- ========================================== -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>


                        <!-- GHI CHÚ -->

                        <StackPanel Grid.Column="0"
                                    Margin="0,0,30,0">

                            <TextBlock Text="Ghi chú"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#172033"/>

                            <TextBox x:Name="NoteTextBox"
                                     Height="100"
                                     Margin="0,15,0,0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top"/>

                        </StackPanel>


                        <!-- TỔNG TIỀN -->

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Tổng giá trị"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#172033"
                                       Margin="0,0,0,15"/>


                            <Grid Margin="0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tạm tính"
                                           Foreground="#596579"/>

                                <TextBlock x:Name="SubTotalText"
                                           Grid.Column="1"
                                           Text="0 VNĐ"
                                           Foreground="#172033"/>

                            </Grid>


                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Chiết khấu"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="1"
                                           Text="0 VNĐ"
                                           Foreground="#172033"/>

                            </Grid>


                            <Border Height="1"
                                    Background="#E1E6EF"
                                    Margin="0,8"/>


                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tổng cộng"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#172033"/>

                                <TextBlock x:Name="TotalAmountText"
                                           Grid.Column="1"
                                           Text="0 VNĐ"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"/>

                            </Grid>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ========================================== -->
                <!-- BUTTON -->
                <!-- ========================================== -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Hủy"
                            Width="100"
                            Height="42"
                            Margin="0,0,10,0"
                            Background="White"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            Foreground="#596579"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="BackButton_Click"/>

                    <Button Content="Lưu báo giá"
                            Width="130"
                            Height="42"
                            Background="#1976D2"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="SaveQuotationButton_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>