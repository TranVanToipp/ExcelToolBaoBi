<UserControl x:Class="ExcelTool.Features.Quotation.QuotationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- TIÊU ĐỀ -->

            <StackPanel>

                <TextBlock Text="Chi tiết báo giá"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Thông tin chi tiết của báo giá"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- QUAY LẠI -->

            <Button Grid.Column="1"
                    Content="←  Quay lại"
                    Width="110"
                    Height="40"
                    Background="White"
                    BorderBrush="#1976D2"
                    BorderThickness="1"
                    Foreground="#1976D2"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="BackButton_Click"/>


            <!-- XUẤT PDF -->

            <Button Grid.Column="3"
                    Content="📄  Xuất PDF"
                    Width="120"
                    Height="40"
                    Background="#1976D2"
                    BorderBrush="#1976D2"
                    BorderThickness="1"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ExportPdfButton_Click"/>

        </Grid>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25,0,25,25">


                <!-- ================================================= -->
                <!-- THÔNG TIN BÁO GIÁ -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin báo giá"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>


                            <!-- MÃ BÁO GIÁ -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Mã báo giá"
                                       Foreground="#7A8499"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="QuotationIdText"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>


                            <!-- NGÀY LẬP -->

                            <TextBlock Grid.Row="0"
                                       Grid.Column="2"
                                       Text="Ngày lập"
                                       Foreground="#7A8499"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="CreatedDateText"
                                       Grid.Row="0"
                                       Grid.Column="3"
                                       Foreground="#172033"
                                       VerticalAlignment="Center"/>


                            <!-- KHÁCH HÀNG -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Khách hàng"
                                       Foreground="#7A8499"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="CustomerNameText"
                                       Grid.Row="1"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="#172033"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>


                            <!-- TRẠNG THÁI -->

                            <TextBlock Grid.Row="1"
                                       Grid.Column="2"
                                       Text="Trạng thái"
                                       Foreground="#7A8499"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Row="1"
                                    Grid.Column="3"
                                    Background="#F1F3F5"
                                    CornerRadius="12"
                                    Padding="10,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">

                                <TextBlock x:Name="StatusText"
                                           Foreground="#596579"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                            </Border>


                            <!-- NGƯỜI LIÊN HỆ -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Người liên hệ"
                                       Foreground="#7A8499"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="ContactPersonText"
                                       Grid.Row="2"
                                       Grid.Column="1"
                                       Foreground="#172033"
                                       VerticalAlignment="Center"/>


                            <!-- ĐIỆN THOẠI -->

                            <TextBlock Grid.Row="2"
                                       Grid.Column="2"
                                       Text="Điện thoại"
                                       Foreground="#7A8499"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="PhoneText"
                                       Grid.Row="2"
                                       Grid.Column="3"
                                       Foreground="#172033"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- CHI TIẾT SẢN PHẨM -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Chi tiết sản phẩm"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"
                                   Margin="0,0,0,20"/>


                        <!-- HEADER -->

                        <Border Background="#F8FAFD"
                                Padding="12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Tên sản phẩm"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="1"
                                           Text="Số lượng"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="2"
                                           Text="Đơn giá"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Grid.Column="3"
                                           Text="Thành tiền"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                            </Grid>

                        </Border>


                        <!-- DANH SÁCH SẢN PHẨM -->

                        <ItemsControl x:Name="QuotationItemList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border BorderBrush="#EEF1F5"
                                            BorderThickness="0,0,0,1"
                                            Padding="12">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="150"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- TÊN -->

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding ProductName}"
                                                       Foreground="#172033"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"/>


                                            <!-- SỐ LƯỢNG -->

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Quantity, StringFormat={}{0:N0}}"
                                                       Foreground="#596579"
                                                       VerticalAlignment="Center"/>


                                            <!-- ĐƠN GIÁ -->

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding UnitPrice, StringFormat={}{0:N0} VNĐ}"
                                                       Foreground="#596579"
                                                       VerticalAlignment="Center"/>


                                            <!-- THÀNH TIỀN -->

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Amount, StringFormat={}{0:N0} VNĐ}"
                                                       FontWeight="SemiBold"
                                                       Foreground="#172033"
                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- TỔNG TIỀN -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>


                        <!-- GHI CHÚ -->

                        <StackPanel>

                            <TextBlock Text="Ghi chú"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#172033"/>

                            <TextBlock x:Name="NoteText"
                                       Text="Không có ghi chú."
                                       Margin="0,8,0,0"
                                       Foreground="#7A8499"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <!-- TỔNG -->

                        <StackPanel Grid.Column="1">

                            <!-- TẠM TÍNH -->

                            <Grid Margin="0,5">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tạm tính"
                                           Foreground="#596579"/>

                                <TextBlock x:Name="SubTotalText"
                                           Grid.Column="1"
                                           Foreground="#172033"/>

                            </Grid>


                            <!-- CHIẾT KHẤU -->

                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Chiết khấu"
                                           Foreground="#596579"/>

                                <TextBlock x:Name="DiscountText"
                                           Grid.Column="1"
                                           Foreground="#172033"/>

                            </Grid>


                            <Border Height="1"
                                    Background="#E1E6EF"
                                    Margin="0,5"/>


                            <!-- TỔNG CỘNG -->

                            <Grid Margin="0,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tổng cộng"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#172033"/>

                                <TextBlock x:Name="TotalAmountText"
                                           Grid.Column="1"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1976D2"/>

                            </Grid>

                        </StackPanel>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>