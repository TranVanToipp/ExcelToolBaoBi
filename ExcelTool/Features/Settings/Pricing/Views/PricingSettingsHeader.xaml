<UserControl x:Class="ExcelTool.Features.Settings.Pricing.Views.PricingSettingsHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

	<Grid Margin="0,0,0,20">

		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="45"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Button x:Name="SidebarToggleButton"
                Grid.Column="0"
                Content="☰"
                Width="38"
                Height="38"
                FontSize="18"
                Background="White"
                Foreground="#1976D2"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                Cursor="Hand"/>

		<StackPanel Grid.Column="1"
                    Margin="10,0,0,0">

			<TextBlock x:Name="CurrentTitle"
                       Text="0. Thông báo"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#172033"/>

			<TextBlock x:Name="CurrentDescription"
                       Text="Các thông báo được sử dụng trong quá trình tính giá."
                       Margin="0,5,0,0"
                       Foreground="#7A8499"/>

		</StackPanel>

	</Grid>

</UserControl>