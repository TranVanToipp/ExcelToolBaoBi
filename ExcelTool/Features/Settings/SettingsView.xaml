<UserControl x:Class="ExcelTool.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="25,25,25,20">

            <TextBlock Text="Cài đặt"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172033"/>

            <TextBlock Text="Thiết lập các tùy chọn cho ứng dụng"
                       Margin="0,5,0,0"
                       FontSize="14"
                       Foreground="#7A8499"/>

        </StackPanel>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25,0,25,25">


                <!-- ================================================= -->
                <!-- THÔNG TIN CÔNG TY -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin công ty"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Thông tin này sẽ được sử dụng khi xuất báo giá PDF."
                                   Margin="0,5,0,20"
                                   Foreground="#7A8499"/>


                        <!-- TÊN CÔNG TY -->

                        <TextBlock Text="Tên công ty"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBox x:Name="CompanyNameTextBox"
                                 Height="38"
                                 Margin="0,8,0,15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>


                        <!-- ĐỊA CHỈ -->

                        <TextBlock Text="Địa chỉ"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBox x:Name="AddressTextBox"
                                 Height="38"
                                 Margin="0,8,0,15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>


                        <!-- MÃ SỐ THUẾ -->

                        <TextBlock Text="Mã số thuế"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBox x:Name="TaxCodeTextBox"
                                 Height="38"
                                 Margin="0,8,0,15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>


                        <!-- ĐIỆN THOẠI -->

                        <TextBlock Text="Số điện thoại"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBox x:Name="CompanyPhoneTextBox"
                                 Height="38"
                                 Margin="0,8,0,15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>


                        <!-- EMAIL -->

                        <TextBlock Text="Email"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBox x:Name="EmailTextBox"
                                 Height="38"
                                 Margin="0,8,0,15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>


                        <!-- WEBSITE -->

                        <TextBlock Text="Website"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBox x:Name="WebsiteTextBox"
                                 Height="38"
                                 Margin="0,8,0,15"
                                 Padding="10,0"
                                 VerticalContentAlignment="Center"/>


                        <!-- LOGO -->

                        <TextBlock Text="Logo công ty"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <Grid Margin="0,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="LogoPathTextBox"
                                     Height="38"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="True"/>

                            <Button Grid.Column="1"
                                    Content="Chọn..."
                                    Width="85"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Background="#EEF5FD"
                                    BorderBrush="#C7DCF5"
                                    BorderThickness="1"
                                    Foreground="#1976D2"
                                    Cursor="Hand"
                                    Click="ChooseLogoButton_Click"/>

                        </Grid>

                    </StackPanel>

                </Border>

                <!-- ================================================= -->
                <!-- THIẾT LẬP TÍNH GIÁ -->
                <!-- ================================================= -->

                <Border Background="White"
        BorderBrush="#E1E6EF"
        BorderThickness="1"
        CornerRadius="10"
        Padding="20"
        Margin="0,0,0,15">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- NỘI DUNG -->

                        <StackPanel>

                            <TextBlock Text="Thiết lập tính giá"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#172033"/>

                            <TextBlock Text="Cấu hình giá giấy, in, bù hao, gia công, khuôn và các thông số tính giá bao bì."
                       Margin="0,5,20,0"
                       Foreground="#7A8499"
                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <!-- BUTTON -->

                        <Button Grid.Column="1"
                Content="Mở thiết lập tính giá →"
                Width="190"
                Height="40"
                Background="#1976D2"
                BorderThickness="0"
                Foreground="White"
                FontWeight="SemiBold"
                Cursor="Hand"
                Click="PricingSettingsButton_Click"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- THƯ MỤC DỮ LIỆU -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thư mục dữ liệu"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Thiết lập nơi ứng dụng lưu trữ dữ liệu."
                                   Margin="0,5,0,18"
                                   Foreground="#7A8499"/>


                        <!-- EXCEL -->

                        <TextBlock Text="File Excel"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <Grid Margin="0,8,0,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ExcelFolderTextBox"
                                     Height="38"
                                     Text="C:\ExcelTool\Data"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="Chọn..."
                                    Width="85"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Background="#EEF5FD"
                                    BorderBrush="#C7DCF5"
                                    BorderThickness="1"
                                    Foreground="#1976D2"
                                    Cursor="Hand"/>

                        </Grid>


                        <!-- ĐÍNH KÈM -->

                        <TextBlock Text="File đính kèm"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <Grid Margin="0,8,0,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AttachmentFolderTextBox"
                                     Height="38"
                                     Text="C:\ExcelTool\Attachments"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="Chọn..."
                                    Width="85"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Background="#EEF5FD"
                                    BorderBrush="#C7DCF5"
                                    BorderThickness="1"
                                    Foreground="#1976D2"
                                    Cursor="Hand"/>

                        </Grid>


                        <!-- BACKUP -->

                        <TextBlock Text="Sao lưu"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <Grid Margin="0,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="BackupFolderTextBox"
                                     Height="38"
                                     Text="C:\ExcelTool\Backup"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Content="Chọn..."
                                    Width="85"
                                    Height="38"
                                    Margin="10,0,0,0"
                                    Background="#EEF5FD"
                                    BorderBrush="#C7DCF5"
                                    BorderThickness="1"
                                    Foreground="#1976D2"
                                    Cursor="Hand"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- GIAO DIỆN -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Giao diện"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Tùy chỉnh giao diện ứng dụng."
                                   Margin="0,5,0,18"
                                   Foreground="#7A8499"/>


                        <Grid Margin="0,0,0,15">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Chế độ giao diện"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Text="Chọn giao diện sáng hoặc tối."
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#9AA3B2"/>

                            </StackPanel>

                            <ComboBox Grid.Column="1"
                                      Height="38"
                                      VerticalContentAlignment="Center">

                                <ComboBoxItem Content="Sáng"
                                              IsSelected="True"/>

                                <ComboBoxItem Content="Tối"/>

                                <ComboBoxItem Content="Theo hệ thống"/>

                            </ComboBox>

                        </Grid>


                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Hiển thị thông báo"
                                           FontWeight="SemiBold"
                                           Foreground="#596579"/>

                                <TextBlock Text="Hiển thị thông báo khi có thao tác hoàn tất."
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="#9AA3B2"/>

                            </StackPanel>

                            <CheckBox Grid.Column="1"
                                      Content="Bật thông báo"
                                      IsChecked="True"
                                      VerticalAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- XỬ LÝ DỮ LIỆU -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Xử lý dữ liệu"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <TextBlock Text="Các tùy chọn liên quan đến việc xử lý dữ liệu."
                                   Margin="0,5,0,18"
                                   Foreground="#7A8499"/>


                        <CheckBox Content="Tự động kiểm tra dữ liệu khi nhập Excel"
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,15"/>

                        <CheckBox Content="Tự động sao lưu trước khi cập nhật"
                                  IsChecked="True"
                                  FontSize="14"
                                  Margin="0,0,0,15"/>

                        <CheckBox Content="Hiển thị cảnh báo khi có dữ liệu trùng"
                                  IsChecked="True"
                                  FontSize="14"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- THÔNG TIN ỨNG DỤNG -->
                <!-- ================================================= -->

                <Border Background="White"
                        BorderBrush="#E1E6EF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="20"
                        Margin="0,0,0,15">

                    <StackPanel>

                        <TextBlock Text="Thông tin ứng dụng"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#172033"/>

                        <Grid Margin="0,15,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Tên ứng dụng"
                                       Foreground="#7A8499"/>

                            <TextBlock Grid.Column="1"
                                       Text="Bao Bì Management"
                                       FontWeight="SemiBold"
                                       Foreground="#253044"/>

                            <TextBlock Grid.Row="1"
                                       Text="Phiên bản"
                                       Foreground="#7A8499"/>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="Version 1.0"
                                       Foreground="#253044"/>

                            <TextBlock Grid.Row="2"
                                       Text="Trạng thái"
                                       Foreground="#7A8499"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Text="Đang hoạt động"
                                       Foreground="#2E7D32"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Khôi phục mặc định"
                            Width="145"
                            Height="42"
                            Margin="0,0,10,0"
                            Background="White"
                            BorderBrush="#D8DEE8"
                            BorderThickness="1"
                            Foreground="#596579"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="RestoreDefaultButton_Click"/>

                    <Button Content="Lưu cài đặt"
                            Width="120"
                            Height="42"
                            Background="#1976D2"
                            BorderThickness="0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="SaveSettingsButton_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>