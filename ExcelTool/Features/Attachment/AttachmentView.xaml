<UserControl x:Class="ExcelTool.Features.Attachment.AttachmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1050">

    <Grid Background="#F5F7FB">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <Grid Grid.Row="0"
              Margin="25,25,25,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Đính kèm"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#172033"/>

                <TextBlock Text="Quản lý các file đính kèm của báo giá và lệnh sản xuất"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#7A8499"/>

            </StackPanel>


            <!-- THÊM FILE -->

            <Button Grid.Column="1"
                    Content="+  Thêm tệp"
                    Width="120"
                    Height="42"
                    Padding="15,0"
                    Background="#1976D2"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="AddAttachmentButton_Click"/>

        </Grid>


        <!-- ========================================== -->
        <!-- FILTER -->
        <!-- ========================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Margin="25,0,25,15"
                Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <Border Grid.Column="0"
                        Height="40"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,10,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="⌕"
                                   FontSize="20"
                                   Foreground="#7A8499"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <TextBox Grid.Column="1"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Text="Tìm kiếm file..."/>

                    </Grid>

                </Border>


                <!-- LOẠI FILE -->

                <ComboBox Grid.Column="1"
                          Height="40"
                          Margin="0,0,10,0"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Tất cả loại file"
                                  IsSelected="True"/>

                    <ComboBoxItem Content="Excel"/>

                    <ComboBoxItem Content="PDF"/>

                    <ComboBoxItem Content="Word"/>

                    <ComboBoxItem Content="Ảnh"/>

                    <ComboBoxItem Content="Khác"/>

                </ComboBox>


                <!-- LỌC -->

                <Button Grid.Column="2"
                        Content="Lọc"
                        Width="70"
                        Height="40"
                        Background="#EEF5FD"
                        BorderBrush="#C7DCF5"
                        BorderThickness="1"
                        Foreground="#1976D2"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>

            </Grid>

        </Border>


        <!-- ========================================== -->
        <!-- TABLE -->
        <!-- ========================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="10"
                Margin="25,0,25,25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->

                <Border Grid.Row="0"
                        Background="#F8FAFD"
                        BorderBrush="#E1E6EF"
                        BorderThickness="0,0,0,1"
                        Padding="15,12">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Grid.Column="0"
                                   Text="Tên file"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="1"
                                   Text="Liên quan"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="2"
                                   Text="Loại"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="3"
                                   Text="Ngày tải lên"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                        <TextBlock Grid.Column="4"
                                   Text="Thao tác"
                                   FontWeight="SemiBold"
                                   Foreground="#596579"/>

                    </Grid>

                </Border>


                <!-- BODY -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel>


                        <!-- FILE 1 -->

                        <Border BorderBrush="#EEF1F5"
                                BorderThickness="0,0,0,1"
                                Padding="15,12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">

                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="#E8F1FC"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="X"
                                                   FontWeight="Bold"
                                                   Foreground="#1976D2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="BaoGia_BG001.xlsx"
                                               FontWeight="SemiBold"
                                               Foreground="#253044"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Grid.Column="1"
                                           Text="BG001"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="Excel"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="14/08/2026"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>


                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal">

                                    <Button Content="Xem"
                                            Width="55"
                                            Height="30"
                                            Margin="0,0,5,0"
                                            Background="Transparent"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Foreground="#1976D2"
                                            Cursor="Hand"/>

                                    <Button Content="Xóa"
                                            Width="55"
                                            Height="30"
                                            Background="Transparent"
                                            BorderBrush="#E57373"
                                            BorderThickness="1"
                                            Foreground="#D32F2F"
                                            Cursor="Hand"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- FILE 2 -->

                        <Border BorderBrush="#EEF1F5"
                                BorderThickness="0,0,0,1"
                                Padding="15,12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">

                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="#FFF1F0"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="P"
                                                   FontWeight="Bold"
                                                   Foreground="#D32F2F"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="ThietKe_LSX001.pdf"
                                               FontWeight="SemiBold"
                                               Foreground="#253044"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Grid.Column="1"
                                           Text="LSX001"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="PDF"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="14/08/2026"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>


                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal">

                                    <Button Content="Xem"
                                            Width="55"
                                            Height="30"
                                            Margin="0,0,5,0"
                                            Background="Transparent"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Foreground="#1976D2"
                                            Cursor="Hand"/>

                                    <Button Content="Xóa"
                                            Width="55"
                                            Height="30"
                                            Background="Transparent"
                                            BorderBrush="#E57373"
                                            BorderThickness="1"
                                            Foreground="#D32F2F"
                                            Cursor="Hand"/>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- FILE 3 -->

                        <Border BorderBrush="#EEF1F5"
                                BorderThickness="0,0,0,1"
                                Padding="15,12">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>


                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal">

                                    <Border Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="#F3E8FF"
                                            Margin="0,0,10,0">

                                        <TextBlock Text="A"
                                                   FontWeight="Bold"
                                                   Foreground="#7B1FA2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Text="FileThietKe.ai"
                                               FontWeight="SemiBold"
                                               Foreground="#253044"
                                               VerticalAlignment="Center"/>

                                </StackPanel>


                                <TextBlock Grid.Column="1"
                                           Text="LSX001"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2"
                                           Text="AI"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="13/08/2026"
                                           Foreground="#596579"
                                           VerticalAlignment="Center"/>


                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal">

                                    <Button Content="Xem"
                                            Width="55"
                                            Height="30"
                                            Margin="0,0,5,0"
                                            Background="Transparent"
                                            BorderBrush="#1976D2"
                                            BorderThickness="1"
                                            Foreground="#1976D2"
                                            Cursor="Hand"/>

                                    <Button Content="Xóa"
                                            Width="55"
                                            Height="30"
                                            Background="Transparent"
                                            BorderBrush="#E57373"
                                            BorderThickness="1"
                                            Foreground="#D32F2F"
                                            Cursor="Hand"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>