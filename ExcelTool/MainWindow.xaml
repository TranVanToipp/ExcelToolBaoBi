<Window x:Class="ExcelTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ExcelTool.Shared.Controls"
        mc:Ignorable="d"

        Title="Excel Automation Tool"
        Height="800"
        Width="1400"
        MinHeight="700"
        MinWidth="1200"

        WindowStartupLocation="CenterScreen"

        Background="{StaticResource BackgroundBrush}">


    <Grid>

        <!-- ================================================= -->
        <!-- ROWS -->
        <!-- ================================================= -->

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="70"/>

            <!-- Main -->
            <RowDefinition Height="*"/>

            <!-- Status bar -->
            <RowDefinition Height="30"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- COLUMNS -->
        <!-- ================================================= -->

        <Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ColumnDefinition Width="230"/>

            <!-- Content -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <controls:HeaderControl
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"/>


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <controls:SidebarControl
    x:Name="Sidebar"
    Grid.Row="1"
    Grid.Column="0"/>


        <!-- ================================================= -->
        <!-- CONTENT -->
        <!-- ================================================= -->

        <Grid
            Grid.Row="1"
            Grid.Column="1"
            Background="{StaticResource BackgroundBrush}">

            <Border
                Margin="20"
                CornerRadius="12"
                Background="White">

                <ContentControl
                    x:Name="MainContent"/>

            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- STATUS BAR -->
        <!-- ================================================= -->

        <controls:StatusBarControl
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"/>

    </Grid>

</Window>