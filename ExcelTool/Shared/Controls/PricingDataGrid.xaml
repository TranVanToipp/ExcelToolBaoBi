<UserControl x:Class="ExcelTool.Shared.Controls.PricingDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExcelTool.Shared.Controls"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Converter tạo STT -->
        <local:RowIndexConverter
            x:Key="RowIndexConverter"/>

    </UserControl.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <!-- TOOLBAR -->
            <RowDefinition Height="Auto"/>

            <!-- DATA GRID -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TOOLBAR -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>

                <!-- SEARCH -->
                <ColumnDefinition Width="*"/>

                <!-- BUTTONS -->
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D9E0EA"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="38">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- SEARCH ICON -->

                    <TextBlock Grid.Column="0"
                               Text="⌕"
                               FontSize="18"
                               Foreground="#7A8499"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0"/>


                    <!-- SEARCH TEXTBOX -->

                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Height="36"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="5,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Nhập từ khóa để tìm kiếm..."
                             TextChanged="SearchTextBox_TextChanged"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- BUTTONS -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="10,0,0,0">


                <!-- XÓA LỌC -->

                <Button Content="Xóa lọc"
                        Width="80"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="White"
                        Foreground="#555F70"
                        BorderBrush="#D9E0EA"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ClearSearchButton_Click"/>


                <!-- IMPORT EXCEL -->

                <Button Content="Import Excel"
                        Width="110"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="White"
                        Foreground="#1976D2"
                        BorderBrush="#1976D2"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="ImportButton_Click"/>


                <!-- THÊM -->

                <Button x:Name="AddButton"
                        Content="+ Thêm"
                        Width="100"
                        Height="38"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="AddButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- DATA GRID -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="DataGrid"

                      AutoGenerateColumns="False"

                      CanUserAddRows="False"
                      CanUserDeleteRows="False"

                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"

                      IsReadOnly="True"

                      HeadersVisibility="Column"

                      GridLinesVisibility="Horizontal"

                      RowHeight="42"

                      MinHeight="350"

                      Background="White"

                      BorderThickness="0"

                      SelectionMode="Single"
                      SelectionUnit="FullRow"

                      AlternationCount="1000000"

                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">


                <!-- ================================================= -->
                <!-- COLUMN HEADER -->
                <!-- ================================================= -->

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#F5F7FB"/>

                        <Setter Property="Foreground"
                                Value="#4D5768"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Padding"
                                Value="12,0"/>

                        <Setter Property="Height"
                                Value="42"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Setter Property="BorderBrush"
                                Value="#E1E6EF"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <!-- ================================================= -->
                <!-- CELL -->
                <!-- ================================================= -->

                <DataGrid.CellStyle>

                    <Style TargetType="DataGridCell">

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                    </Style>

                </DataGrid.CellStyle>


                <!-- ================================================= -->
                <!-- ROW -->
                <!-- ================================================= -->

                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Setter Property="Background"
                                Value="White"/>

                        <Setter Property="BorderBrush"
                                Value="#E5E9F0"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>

                    </Style>

                </DataGrid.RowStyle>


            </DataGrid>

        </Border>

    </Grid>

</UserControl>