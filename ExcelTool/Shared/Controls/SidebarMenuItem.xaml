<UserControl x:Class="ExcelTool.Shared.Controls.SidebarMenuItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <Style x:Key="MenuItemBorderStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Margin"
                    Value="6,3"/>

            <Setter Property="Padding"
                    Value="12"/>

            <Style.Triggers>

                <!-- Hover -->

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#164A88"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <Border x:Name="MenuBorder"
        Style="{StaticResource MenuItemBorderStyle}"
        Cursor="Hand"
        MouseLeftButtonUp="MenuBorder_MouseLeftButtonUp">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="36"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ========================= -->
            <!-- ICON -->
            <!-- ========================= -->

            <TextBlock
                Grid.Column="0"
                Text="{Binding Icon,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontFamily="Segoe MDL2 Assets"
                FontSize="18"
                Foreground="#D9E9FF"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>


            <!-- ========================= -->
            <!-- TITLE -->
            <!-- ========================= -->

            <TextBlock
                Grid.Column="1"
                Text="{Binding Title,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                VerticalAlignment="Center"
                Margin="8,0,0,0"/>

        </Grid>

    </Border>

</UserControl>