<UserControl x:Class="ExcelTool.Shared.Controls.WasteDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- TOOLBAR -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- SEARCH -->
            <!-- ================================================= -->

            <Border Background="White"
                    BorderBrush="#D9E0EA"
                    BorderThickness="1"
                    CornerRadius="6"
                    Height="38">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="⌕"
                               FontSize="18"
                               Foreground="#7A8499"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0"/>


                    <TextBox x:Name="SearchTextBox"
                             Grid.Column="1"
                             Height="36"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="5,0"
                             VerticalContentAlignment="Center"
                             ToolTip="Nhập từ khóa để tìm kiếm..."
                             TextChanged="SearchTextBox_TextChanged"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- BUTTONS -->
            <!-- ================================================= -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Margin="10,0,0,0">


                <!-- XÓA LỌC -->

                <Button Content="Xóa lọc"
                        Width="80"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="White"
                        Foreground="#555F70"
                        BorderBrush="#D9E0EA"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="ClearSearchButton_Click"/>


                <!-- IMPORT -->

                <Button Content="Import Excel"
                        Width="110"
                        Height="38"
                        Margin="0,0,10,0"
                        Background="White"
                        Foreground="#1976D2"
                        BorderBrush="#1976D2"
                        BorderThickness="1"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="ImportButton_Click"/>


                <!-- THÊM -->

                <Button x:Name="AddButton"
                        Content="+ Thêm"
                        Width="100"
                        Height="38"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="AddButton_Click"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- DATA GRID -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E1E6EF"
                BorderThickness="1"
                CornerRadius="8">

            <DataGrid x:Name="DataGrid"
                      AutoGenerateColumns="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      MinHeight="350"
                      Background="White"
                      BorderThickness="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      FrozenColumnCount="1"
                      AlternationCount="2147483647"
                      AutoGeneratingColumn="DataGrid_AutoGeneratingColumn"
                      AutoGeneratedColumns="DataGrid_AutoGeneratedColumns"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">


                <!-- ================================================= -->
                <!-- COLUMN HEADER -->
                <!-- ================================================= -->

                <DataGrid.ColumnHeaderStyle>

                    <Style TargetType="DataGridColumnHeader">

                        <Setter Property="Background"
                                Value="#F5F7FB"/>

                        <Setter Property="Foreground"
                                Value="#4D5768"/>

                        <Setter Property="FontWeight"
                                Value="SemiBold"/>

                        <Setter Property="Padding"
                                Value="12,0"/>

                        <Setter Property="Height"
                                Value="44"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                    </Style>

                </DataGrid.ColumnHeaderStyle>


                <!-- ================================================= -->
                <!-- CELL -->
                <!-- ================================================= -->

                <DataGrid.CellStyle>

                    <Style TargetType="DataGridCell">

                        <Setter Property="Padding"
                                Value="10,0"/>

                        <Setter Property="VerticalContentAlignment"
                                Value="Center"/>

                        <Setter Property="HorizontalContentAlignment"
                                Value="Center"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                    </Style>

                </DataGrid.CellStyle>


                <!-- ================================================= -->
                <!-- ROW -->
                <!-- ================================================= -->

                <DataGrid.RowStyle>

                    <Style TargetType="DataGridRow">

                        <Setter Property="Background"
                                Value="White"/>

                        <Setter Property="BorderBrush"
                                Value="#E5E9F0"/>

                        <Setter Property="BorderThickness"
                                Value="0,0,0,1"/>

                    </Style>

                </DataGrid.RowStyle>

            </DataGrid>

        </Border>

    </Grid>

</UserControl>