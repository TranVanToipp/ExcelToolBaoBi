<UserControl x:Class="ExcelTool.Shared.Controls.SidebarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ExcelTool.Shared.Controls">

    <Border Background="#082B5C">

        <Grid>

            <Grid.RowDefinitions>

                <!-- Logo -->
                <RowDefinition Height="Auto"/>

                <!-- Menu -->
                <RowDefinition Height="*"/>

                <!-- Footer -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- LOGO -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Margin="15,24,15,20">

                <!-- Logo icon -->

                <Border
                    Width="58"
                    Height="58"
                    CornerRadius="14"
                    Background="#1268D5"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="▣"
                        FontSize="32"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <!-- Application name -->

                <TextBlock
                    Text="Bao Bì Management"
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"/>


                <!-- Subtitle -->

                <TextBlock
                    Text="Packaging Management"
                    FontSize="11"
                    Foreground="#9DB9DA"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- MENU -->
            <!-- ================================================= -->

            <ScrollViewer
    Grid.Row="1"
    VerticalScrollBarVisibility="Auto"
    HorizontalScrollBarVisibility="Disabled">

                <StackPanel Margin="8,5">

                    <!-- ===================== -->
                    <!-- MAIN -->
                    <!-- ===================== -->

                    <TextBlock
            Text="MAIN"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6F91B9"
            Margin="14,5,0,8"/>


                    <!-- Dashboard -->
                    <controls:SidebarMenuItem
            Icon="&#xE80F;"
            Title="Dashboard"/>


                    <!-- Dữ liệu -->
                    <controls:SidebarMenuItem
                        x:Name="DataMenu"
                        Icon="&#xE8B7;"
                        Title="Dữ liệu"
                        MenuClicked="Sidebar_Data_Click"/>


                    <!-- Khách hàng -->
                    <controls:SidebarMenuItem
                        x:Name="CustomerMenu"
                        Icon="&#xE716;"
                        Title="Khách hàng"
                        MenuClicked="Sidebar_Customer_Click"/>


                    <!-- ===================== -->
                    <!-- QUẢN LÝ -->
                    <!-- ===================== -->

                    <TextBlock
            Text="QUẢN LÝ"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6F91B9"
            Margin="14,20,0,8"/>


                    <!-- Báo giá -->
                    <!-- Báo giá -->
                    <controls:SidebarMenuItem
                        x:Name="QuotationMenu"
                        Icon="&#xE8A5;"
                        Title="Báo giá"
                        MenuClicked="Sidebar_Quotation_Click"/>


                    <!-- Lệnh sản xuất -->
                    <!-- Lệnh sản xuất -->
                    <controls:SidebarMenuItem
                        x:Name="ProductionMenu"
                        Icon="&#xE9F9;"
                        Title="Lệnh sản xuất"
                        MenuClicked="Sidebar_Production_Click"/>


                    <!-- Đính kèm -->
                    <controls:SidebarMenuItem
                        x:Name="AttachmentMenu"
                        Icon="&#xE723;"
                        Title="Đính kèm"
                        MenuClicked="Sidebar_Attachment_Click"/>


                    <!-- ===================== -->
                    <!-- BÁO CÁO -->
                    <!-- ===================== -->

                    <TextBlock
            Text="BÁO CÁO"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6F91B9"
            Margin="14,20,0,8"/>


                    <!-- Báo cáo -->
                    <!-- Báo cáo -->
                    <controls:SidebarMenuItem
                        x:Name="ReportMenu"
                        Icon="&#xE9D2;"
                        Title="Báo cáo"
                        MenuClicked="Sidebar_Report_Click"/>


                    <!-- ===================== -->
                    <!-- HỆ THỐNG -->
                    <!-- ===================== -->

                    <TextBlock
            Text="HỆ THỐNG"
            FontSize="10"
            FontWeight="Bold"
            Foreground="#6F91B9"
            Margin="14,20,0,8"/>


                    <!-- Công cụ -->
                    <controls:SidebarMenuItem
                        x:Name="ToolMenu"
                        Icon="&#xE90F;"
                        Title="Công cụ"
                        MenuClicked="Sidebar_Tool_Click"/>


                    <!-- Cài đặt -->
                    <controls:SidebarMenuItem
                        x:Name="SettingsMenu"
                        Icon="&#xE713;"
                        Title="Cài đặt"
                        MenuClicked="Sidebar_Settings_Click"/>


                    <!-- Giới thiệu -->
                    <controls:SidebarMenuItem
                        x:Name="AboutMenu"
                        Icon="&#xE946;"
                        Title="Giới thiệu"
                        MenuClicked="Sidebar_About_Click"/>

                </StackPanel>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- FOOTER -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Row="2"
                Margin="15,10,15,15">


                <!-- Separator -->

                <Border
                    Height="1"
                    Background="#214B78"
                    Margin="0,0,0,12"/>


                <!-- Online -->

                <Border
                    Background="#0D3B73"
                    CornerRadius="8"
                    Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- Status -->

                        <StackPanel
                            Orientation="Horizontal">

                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="#22C55E"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="  Online"
                                FontSize="12"
                                Foreground="#A7F3D0"
                                VerticalAlignment="Center"/>

                        </StackPanel>


                        <!-- Version -->

                        <TextBlock
                            Grid.Row="1"
                            Text="Version 1.0"
                            FontSize="11"
                            Foreground="#8EABD0"
                            Margin="0,8,0,0"/>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>