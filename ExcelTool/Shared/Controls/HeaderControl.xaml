<UserControl x:Class="ExcelTool.Shared.Controls.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="#1677D2"
            Height="70">

        <Grid Margin="18,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- ================================================= -->
            <!-- LEFT : APPLICATION -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                VerticalAlignment="Center">

                <!-- Application Icon -->

                <Border
                    Width="40"
                    Height="40"
                    CornerRadius="8"
                    Background="#0F63B8"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="&#xE8A5;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="22"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <!-- Application Name -->

                <StackPanel
                    Margin="12,0,0,0"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Quản Lý Bao Bì"
                        FontSize="19"
                        FontWeight="Bold"
                        Foreground="White"/>

                    <TextBlock
                        Text="Version 1.0"
                        FontSize="11"
                        Foreground="#DCEEFF"
                        Margin="0,2,0,0"/>

                </StackPanel>

            </StackPanel>


            <!-- ================================================= -->
            <!-- RIGHT : USER -->
            <!-- ================================================= -->

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">


                <!-- Online indicator -->

                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="#22C55E"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"/>


                <!-- User Icon -->

                <TextBlock
                    Text="&#xE77B;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="20"
                    Foreground="White"
                    VerticalAlignment="Center"/>


                <!-- User Name -->

                <TextBlock
                    Text="Quản trị viên"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"/>


                <!-- Dropdown -->

                <TextBlock
                    Text="&#xE70D;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="11"
                    Foreground="#DCEEFF"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"/>

            </StackPanel>

        </Grid>

    </Border>

</UserControl>