<UserControl x:Class="ExcelTool.Shared.Controls.StatisticCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <DropShadowEffect
            x:Key="CardShadow"
            BlurRadius="10"
            ShadowDepth="2"
            Opacity="0.10"/>

    </UserControl.Resources>


    <Border
        Background="White"
        BorderBrush="#E5E7EB"
        BorderThickness="1"
        CornerRadius="10"
        Padding="18"
        Effect="{StaticResource CardShadow}">

        <Grid>

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <StackPanel
                Orientation="Horizontal">

                <Border
                    Width="36"
                    Height="36"
                    CornerRadius="8"
                    Background="#E8F2FF">

                    <TextBlock
                        Text="&#xE8A5;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="18"
                        Foreground="#1677D2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <TextBlock
                    Text="{Binding Title,
                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#374151"
                    VerticalAlignment="Center"
                    Margin="10,0,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- VALUE -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Row="1"
                Text="{Binding Value,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="36"
                FontWeight="Bold"
                Foreground="#1677D2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,12"/>


            <!-- ================================================= -->
            <!-- SUBTITLE -->
            <!-- ================================================= -->

            <TextBlock
                Grid.Row="2"
                Text="{Binding Subtitle,
                       RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="12"
                Foreground="#9CA3AF"
                HorizontalAlignment="Center"/>

        </Grid>

    </Border>

</UserControl>