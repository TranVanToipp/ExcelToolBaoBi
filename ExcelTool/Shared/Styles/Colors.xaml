<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#1976D2"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1565C0"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBrush" Color="#263238"/>

    <!-- Background -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F5F5"/>

    <!-- Card -->
    <SolidColorBrush x:Key="CardBrush" Color="White"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#757575"/>

    <!-- Status -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#43A047"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FB8C00"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#E53935"/>

</ResourceDictionary>